# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional PageSpeed
PAGESPEED_API_KEY=

# Live Google rank (pick one)
SERPER_API_KEY=
SERPAPI_KEY=
SERP_GL=in
SERP_HL=en

# Email reports (client + admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="RankScope <your@gmail.com>"
ADMIN_EMAIL=admin@youragency.com

# App + security
APP_BASE_URL=http://localhost:3001
CRON_SECRET=change-me-long-random
ADMIN_SECRET=change-me-long-random
ADMIN_PASSWORD=change-me-admin-login
